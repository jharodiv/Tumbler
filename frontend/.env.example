# Where the Vite dev server proxies /api requests (tumbler-backend-typescript)
VITE_API_PROXY_TARGET=http://localhost:5001

# Base URL the app calls. Leave as /api/v1 to go through the proxy (recommended, keeps the
# session cookie same-origin). Set a full URL only if the API is served from another origin,
# and add this app's origin to the backend's CORS_ORIGIN.
# /api/v1 is appended automatically when missing, so https://example.com and
# https://example.com/api/v1 both work.
VITE_API_BASE_URL=/api/v1
